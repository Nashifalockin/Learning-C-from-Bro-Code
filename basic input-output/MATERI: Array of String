// Array of String --> using 2D Array
// Basically stores character / string

#include <stdio.h>
#include <string.h>  //we're working with string

int main() {
    
    char fruits[][10] = {"Apple" , 
                         "Banana" ,
                         "Coconut"};
    
    int size = sizeof(fruits) / sizeof(fruits[0]);
    
    /*
    kita juga bisa ngubah huruf pertama and terakhir elemen (basically ANY huruf arraynya)
    
    fruits[0][0] = 'e'; --> dari Apple --> epplA
    fruits[0][4] = 'A';
    
    DST
    */
                         
    //TO DISPLAY --> using for loop
    
    for (int i = 0; i < size; i++ ){
        printf("%s\n" , fruits[i]);
        
    }
    return 0;
