//what if mau bikin 2D array tapi character? bisa
#include <stdio.h>

int main(){
    
    char numpad[][3] = {{'1' , '2' , '3'}, 
                        {'4' , '5' , '6'} , 
                        {'7' , '8' , '9'} , 
                        {'*' , '0' , '#'}};
                       
  // [3] --> this is for column     
  // [] untuk baris boleh kosong, karena  array[][] = {{} , {} , {}} di dalam array ada 3 array lainnya --> sistem udah langsung anggap itu sebagai baris (di isi juga boleh euy) 
   
  //HOW TO DISPLAY ALL --> nested for loop
   
  for (int i = 0; i < 4; i++){  //baris
      for (int j = 0; j < 3; j++){  //kolom
          printf("%c " , numpad[i][j]);
      }
      printf("\n");
   
       
  }
}
